# Pinned runtime versions for the portable build. Bump + rebuild to update.

# Node.js (nodejs.org official portable builds)
NODE_VERSION=22.14.0

# CPython via astral-sh/python-build-standalone (relocatable). Resolved against the dated tag.
PYTHON_VERSION=3.12.9
PYTHON_RELEASE=20250317

# Portable git via desktop/dugite-native (relocatable git for all platforms).
DUGITE_VERSION=v2.47.1

# Standalone Chrome via Google "Chrome for Testing" (per-platform browser + driver).
# "Stable" resolves the latest stable through the CfT JSON endpoint at build time.
CHROME_CHANNEL=Stable

# Agent CLIs (npm)
CLAUDE_PKG=@anthropic-ai/claude-code
CODEX_PKG=@openai/codex

# Source of the .claude folder (skills + webapp) to vendor into the package.
FLOW0_DIR=${FLOW0_DIR:-$HOME/_code/_flow0}

# Build targets (platform tokens used throughout the build + launchers).
TARGETS="linux-x64 win-x64 darwin-x64 darwin-arm64"
